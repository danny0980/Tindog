# Chronos Chess game server settings. Copy to server/.env and fill in.

# Where the server listens (the Vite dev server proxies /api and /ws here).
PORT=8787

# The address players open. Used for magic links and origin checks. Required in production.
# PUBLIC_URL=https://chess.example.com

# Google Sign-In: create an OAuth "Web application" client at
# https://console.cloud.google.com/apis/credentials and add your site
# (and http://localhost:5175 for development) to its Authorized JavaScript origins.
# The same id goes in the app's .env as VITE_GOOGLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Email sign-in links. Without SMTP_URL (development), links are printed in the server console.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Chronos Chess <no-reply@example.com>"

# The SQLite database: accounts, saves, rated games, seasons, tournaments, clans and the modes' ratings.
# DATABASE_FILE=server-data/chess.db

# The JSON data file of 6.14 and earlier: imported into a fresh database on first start, then renamed .imported.
# LEGACY_DATA_FILE=server-data/db.json

# Automatic backups (production): a consistent copy every BACKUP_HOURS, keeping BACKUP_KEEP. BACKUP_DIR=off switches them off.
# BACKUP_DIR=server-data/backups
# BACKUP_HOURS=24
# BACKUP_KEEP=7

# How many reverse proxies (Caddy, nginx, a load balancer) sit in front, for the real client IP. 0 = none.
# TRUST_PROXY=1

# The interface to listen on.
# HOST=0.0.0.0

# How long a sign-in lasts, in days.
# SESSION_DAYS=30
