{
  "name": "chess-arena",
  "private": true,
  "version": "6.15.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-stockfish.mjs",
    "predev": "node scripts/scan-assets.mjs",
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "server:prod": "tsx server/index.ts --production",
    "start": "node dist-server/index.mjs --production",
    "db": "tsx server/cli.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "prebuild": "node scripts/scan-assets.mjs",
    "build": "tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run build && npm run build:server",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "validate:data": "node scripts/validate-data.mjs",
    "generate:puzzles": "node scripts/generate-puzzles.mjs 120",
    "check": "npm run typecheck && npm run lint && npm run validate:data && npm run test:legends && npm run test:campaign && npm run test:resilience && npm run test:roguelike && npm run test:ultimate && npm run test:cinematic && npm run test:lastgrain && npm run test:online && npm run test:lore && npm run test:variants && npm run test:openings && npm run test:server && npm run test:assets && npm run test:vfx && npm run test:expansion && npm run test:classic && npm run test:history && npm run test:cinema && npm run test:mind && npm run test:conquest && npm run test:league && npm run test:modes && npm run test:storage && npm run test:online-modes",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "test:legends": "node scripts/run-ts-test.mjs tests/legends.test.ts",
    "test:campaign": "node scripts/run-ts-test.mjs tests/campaign.test.ts",
    "test:resilience": "node scripts/run-ts-test.mjs tests/resilience.test.ts",
    "test:roguelike": "node scripts/run-ts-test.mjs tests/roguelike.test.ts",
    "test:ultimate": "node scripts/run-ts-test.mjs tests/ultimate.test.ts",
    "test:cinematic": "node scripts/run-ts-test.mjs tests/cinematic.test.ts",
    "test:lastgrain": "node scripts/run-ts-test.mjs tests/lastgrain.test.ts",
    "test:online": "node scripts/run-ts-test.mjs tests/online.test.ts",
    "test:lore": "node scripts/run-ts-test.mjs tests/lore.test.ts",
    "test:variants": "node scripts/run-ts-test.mjs tests/variants.test.ts",
    "test:openings": "node scripts/run-ts-test.mjs tests/openings.test.ts",
    "test:server": "tsx tests/server.test.ts",
    "assets:import": "node scripts/import-assets.mjs",
    "assets:missing": "node scripts/run-ts-test.mjs scripts/missing-portraits.ts",
    "assets:audit": "node scripts/run-ts-test.mjs scripts/missing-portraits.ts",
    "assets:scan": "node scripts/scan-assets.mjs",
    "test:assets": "node scripts/run-ts-test.mjs tests/assets.test.ts",
    "test:vfx": "node scripts/run-ts-test.mjs tests/vfx.test.ts",
    "test:expansion": "node scripts/run-ts-test.mjs tests/expansion.test.ts",
    "test:classic": "node scripts/run-ts-test.mjs tests/classic.test.ts",
    "test:history": "node scripts/run-ts-test.mjs tests/history.test.ts",
    "test:cinema": "node scripts/run-ts-test.mjs tests/cinema.test.ts",
    "test:mind": "node scripts/run-ts-test.mjs tests/mind.test.ts",
    "test:conquest": "node scripts/run-ts-test.mjs tests/conquest.test.ts",
    "test:league": "tsx tests/league.test.ts",
    "test:modes": "node scripts/run-ts-test.mjs tests/modes.test.ts",
    "test:storage": "tsx tests/storage.test.ts",
    "test:online-modes": "tsx tests/online-modes.test.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "better-sqlite3": "^12.11.1",
    "chess.js": "^1.4.0",
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "google-auth-library": "^10.9.1",
    "nodemailer": "^10.1.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.59.0",
    "oxlint": "^1.81.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "stockfish": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
